          "stringUnit": {
            "state": "translated",
            "value": "Üst köşedeki + düğmesine dokun ve Vocabi’yi ara."
          }
        }
      }
    },
    "Tap the widget to see the next word.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el widget para ver la siguiente palabra."
          }

        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le widget pour voir le mot suivant."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki kelime için widget’a dokun."
          }
        }
      }
    },

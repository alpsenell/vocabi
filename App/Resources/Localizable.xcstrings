    "Touch and hold an empty area of your home screen until the apps jiggle.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una zona vacía de la pantalla de inicio hasta que las apps se muevan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le doigt sur une zone vide de l’écran d’accueil jusqu’à ce que les apps bougent."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar titreyene kadar ana ekranda boş bir alana dokunup basılı tut."
          }
        }
      }
    },
